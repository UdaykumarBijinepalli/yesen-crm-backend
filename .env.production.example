# Production environment. Secrets below are placeholders — populate real
# values via your hosting provider's secret manager, not by committing a
# filled-in .env.production to source control.

NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://<prod-user>:<prod-pass>@<prod-cluster>.mongodb.net/yesen_crm

JWT_SECRET=replace_with_a_long_random_production_secret
JWT_EXPIRES_IN=7d

CORS_ORIGINS=https://yesentechnologies.com,https://admin.yesentechnologies.com

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

FORMS_API_KEY=replace_with_a_long_random_production_forms_key

LOG_LEVEL=warn
LOG_DIR=logs
LOG_TO_FILE=true
LOG_RETENTION_DAYS=14

API_VERSION=v1

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
FORMS_RATE_LIMIT_MAX=30

AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=5

# Do not seed a default admin password in production — create the first
# admin manually via the seed script with a strong, unique password passed
# as an env var at run time instead of committing one here.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrator
