# Copy this to .env.development / .env.uat / .env.production and fill in
# real values. NODE_ENV determines which of those files gets loaded — see
# README.md "Environments" section. Real .env.* files are gitignored;
# only this example and the per-environment *.example files are committed.

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/yesen_crm_dev

# Auth
JWT_SECRET=change_this_to_a_long_random_string_at_least_16_chars
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins (your website + admin panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Uploaded documents (invoices/quotations) storage
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# Shared secret the public website forms must send as `x-forms-key` so the
# intake endpoints aren't wide open to arbitrary internet POSTs.
FORMS_API_KEY=change_this_forms_key_min_8_chars

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
LOG_DIR=logs
LOG_TO_FILE=false
LOG_RETENTION_DAYS=14

# API versioning - routes are served at /api/{API_VERSION} (e.g. /api/v1),
# plus an unversioned /api alias kept for backward compatibility.
API_VERSION=v1

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
FORMS_RATE_LIMIT_MAX=30

# Separate, much stricter limiter on POST /api/v1/auth/login to blunt
# credential-stuffing/brute-force. Successful logins don't count against it.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=5

# First admin account created by `pnpm seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator

# SMTP (nodemailer) — required in production for password reset emails.
# In development, if SMTP_HOST is empty, OTP codes are logged to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=prajwalanagekar@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Yesen CRM <prajwalanagekar@gmail.com>"
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
