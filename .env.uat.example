# UAT (staging) environment — mirrors production settings but points at
# the UAT database/cluster and allows the UAT frontend origin.

NODE_ENV=uat
PORT=5000

MONGO_URI=mongodb+srv://<uat-user>:<uat-pass>@<uat-cluster>.mongodb.net/yesen_crm_uat

JWT_SECRET=replace_with_a_long_random_uat_secret
JWT_EXPIRES_IN=7d

CORS_ORIGINS=https://uat.yesentechnologies.com,https://uat-admin.yesentechnologies.com

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

FORMS_API_KEY=replace_with_a_long_random_uat_forms_key

LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=true
LOG_RETENTION_DAYS=14

API_VERSION=v1

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=200
FORMS_RATE_LIMIT_MAX=50

AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=5

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_a_strong_uat_password
SEED_ADMIN_NAME=Administrator
